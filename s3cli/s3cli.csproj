<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>s3cli</AssemblyName>
    <RootNamespace>s3cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Version>1.4.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Modern AWS SDK v3 (replaces the old monolithic AWSSDK 2.x) -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.19" />
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.*" />
    <PackageReference Include="PowerArgs" Version="4.0.*" />
    <!-- Microsoft.Win32.Registry provides Windows Registry support on .NET Core -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.*" />
  </ItemGroup>

</Project>
